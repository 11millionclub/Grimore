# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle;
# never put the Supabase service-role key or any other secret here.

# Supabase project URL (Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://atyggjdofzdfjbfbisbf.supabase.co

# Supabase anon / publishable key (safe for clients; access is enforced by RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Google Books API key restricted to the Books API and your app IDs
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
